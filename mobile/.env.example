# Supabase — get these from your Supabase project dashboard
# Project Settings → API. The anon key is public-by-design (RLS protects data).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Persona (ID verification) — optional for mobile
EXPO_PUBLIC_PERSONA_TEMPLATE_ID=your-persona-template-id

# App variant — set automatically by eas.json per build profile
APP_VARIANT=development
