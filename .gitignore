# ============================================================
# GigTim — Root .gitignore
# ============================================================

# ── OS files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Environment variables (CRITICAL — never commit) ─────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ── Node / Next.js ───────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── Supabase local ──────────────────────────────────────────
.supabase/

# ── Logs ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Misc ─────────────────────────────────────────────────────
*.pem
*.zip
coverage/
.vercel
web/.vercel
mobile/.expo
